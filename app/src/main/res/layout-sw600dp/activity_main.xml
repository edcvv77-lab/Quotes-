<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/quotes_background"
    android:padding="28dp">

    <LinearLayout
        android:layout_width="820dp"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_quotes_header"
            android:padding="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|top"
                android:layout_marginTop="-24dp"
                android:alpha="0.10"
                android:text="“"
                android:textColor="@color/quotes_white"
                android:textSize="132sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="start"
                    android:text="اقتباسات"
                    android:textColor="@color/quotes_white"
                    android:textSize="39sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="مساحتك الهادئة للكلمات التي تستحق أن تبقى"
                    android:textColor="#DCE8E5"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/tvQuoteCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_quote_chip"
                    android:paddingStart="15dp"
                    android:paddingTop="7dp"
                    android:paddingEnd="15dp"
                    android:paddingBottom="7dp"
                    android:text="0 اقتباس"
                    android:textColor="@color/quotes_primary_dark"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etQuoteSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_quote_search"
                android:drawableStart="@drawable/ic_search_24"
                android:drawablePadding="11dp"
                android:hint="ابحث بكلمة أو فكرة..."
                android:imeOptions="actionDone"
                android:inputType="text"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:singleLine="true"
                android:textColor="@color/quotes_text"
                android:textColorHint="@color/quotes_text_secondary"
                android:textDirection="locale"
                android:textSize="16sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFavoriteFilter"
                style="@style/Widget.Aiham.SecondaryButton"
                android:layout_width="170dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:text="☆ المفضلة"
                app:icon="@drawable/ic_star_24"
                app:iconGravity="textStart" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddQuote"
                style="@style/Widget.Aiham.PrimaryButton"
                android:layout_width="190dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:text="اقتباس جديد"
                app:icon="@drawable/ic_add_24"
                app:iconGravity="textStart" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="36dp"
                android:layout_height="2dp"
                android:background="@color/quotes_accent" />

            <TextView
                android:id="@+id/tvListStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="كل الاقتباسات"
                android:textColor="@color/quotes_text_secondary"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="9dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/quotesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="20dp" />
        </ScrollView>
    </LinearLayout>
</FrameLayout>