<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1220"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="720dp"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="المساحة الخاصة"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="تطبيقات منفصلة داخل اقتباسات"
            android:textColor="#94A3B8"
            android:textSize="16sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvPrivateStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_secure_app_tile"
            android:text="جاري التحقق..."
            android:textColor="#CBD5E1"
            android:textSize="16sp"
            android:padding="14dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPickApk"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="56dp"
                android:text="إضافة APK" />

            <Button
                android:id="@+id/btnCloneInstalledApp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:minHeight="56dp"
                android:text="نسخ تطبيق مثبت" />

            <Button
                android:id="@+id/btnRefreshApps"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:minHeight="56dp"
                android:text="تحديث" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="اضغط على التطبيق لتشغيله، واضغط مطولًا للإدارة."
            android:textColor="#64748B"
            android:textSize="13sp"
            android:paddingTop="6dp"
            android:paddingBottom="10dp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <GridLayout
                android:id="@+id/appsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="4"
                android:alignmentMode="alignMargins"
                android:useDefaultMargins="false" />
        </ScrollView>

        <Button
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:text="قفل والعودة للاقتباسات" />
    </LinearLayout>
</FrameLayout>
