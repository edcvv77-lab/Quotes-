<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="@color/private_surface" />
            <stroke android:width="1dp" android:color="@color/private_border" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item android:gravity="start" android:width="4dp">
        <shape>
            <solid android:color="@color/private_primary_bright" />
            <corners android:topLeftRadius="20dp" android:bottomLeftRadius="20dp" />
        </shape>
    </item>
</layer-list>