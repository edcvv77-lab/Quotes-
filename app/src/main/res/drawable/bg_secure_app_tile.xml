<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#1C3342" />
            <stroke android:width="1dp" android:color="@color/private_primary_bright" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:angle="90" android:startColor="#162434" android:endColor="#111D2A" />
            <stroke android:width="1dp" android:color="@color/private_border" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</selector>