<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <gradient android:angle="90" android:startColor="#F8DFE8" android:endColor="#F4E1F3" />
            <stroke android:width="1dp" android:color="#D98DA8" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:angle="90" android:startColor="#FFFDFC" android:endColor="#FFF4F7" />
            <stroke android:width="1dp" android:color="#EAB8C6" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</selector>