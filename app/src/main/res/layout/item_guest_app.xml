<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/guestTile"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minHeight="142dp"
    android:background="@drawable/bg_secure_app_tile"
    android:clickable="true"
    android:elevation="2dp"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="11dp">

    <FrameLayout
        android:layout_width="74dp"
        android:layout_height="74dp"
        android:background="@drawable/bg_app_icon_plate"
        android:padding="6dp">

        <ImageView
            android:id="@+id/ivGuestIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="أيقونة التطبيق"
            android:scaleType="fitCenter"
            android:src="@android:drawable/sym_def_app_icon" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvGuestLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="@color/private_text"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="13dp"
            android:contentDescription="قلب"
            android:src="@drawable/ic_hadeel_heart" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:text="هديل"
            android:textColor="@color/private_primary"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>