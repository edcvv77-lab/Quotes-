<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/guestTile"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minHeight="132dp"
    android:background="@drawable/bg_secure_app_tile"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="12dp">

    <FrameLayout
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/bg_app_icon_plate"
        android:padding="6dp">

        <ImageView
            android:id="@+id/ivGuestIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="أيقونة التطبيق"
            android:scaleType="fitCenter"
            android:src="@android:drawable/sym_def_app_icon" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvGuestLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="@color/private_text"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="داخل المساحة"
        android:textColor="@color/private_muted"
        android:textSize="9sp" />
</LinearLayout>