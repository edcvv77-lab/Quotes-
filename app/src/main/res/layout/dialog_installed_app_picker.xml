<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_picker_panel"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_private_chip">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:contentDescription="نسخ تطبيق"
                android:src="@drawable/ic_clone_24" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="اختر تطبيقًا لنسخه"
                android:textColor="@color/private_text"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="ابحث بالاسم ثم اضغط على التطبيق"
                android:textColor="@color/private_muted"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <EditText
        android:id="@+id/etInstalledAppSearch"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="15dp"
        android:background="@drawable/bg_picker_search"
        android:drawableStart="@drawable/ic_search_24"
        android:drawablePadding="10dp"
        android:hint="بحث عن تطبيق..."
        android:imeOptions="actionDone"
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="@color/private_text"
        android:textColorHint="@color/private_muted"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/tvInstalledAppCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_private_chip"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:paddingEnd="10dp"
        android:paddingBottom="4dp"
        android:textColor="@color/private_success"
        android:textSize="11sp"
        android:textStyle="bold" />

    <ListView
        android:id="@+id/listInstalledApps"
        android:layout_width="match_parent"
        android:layout_height="420dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:divider="#223445"
        android:dividerHeight="1dp"
        android:overScrollMode="never"
        android:paddingBottom="6dp"
        android:scrollbars="vertical" />

    <TextView
        android:id="@+id/tvInstalledAppEmpty"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:gravity="center"
        android:text="لا توجد تطبيقات مطابقة للبحث."
        android:textColor="@color/private_muted"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>