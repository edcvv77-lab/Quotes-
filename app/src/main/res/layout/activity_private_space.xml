<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:layoutDirection="rtl">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="المساحة الخاصة"
        android:textSize="28sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvPrivateStatus"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="جارٍ التحقق..."
        android:textSize="18sp"
        android:gravity="center"
        android:padding="16dp" />

    <Button
        android:id="@+id/btnInstallApk"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="تثبيت التطبيق التجريبي" />

    <Button
        android:id="@+id/btnListApps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="عرض التطبيقات المعزولة" />

    <Button
        android:id="@+id/btnLaunchApp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="تشغيل التطبيق التجريبي" />

    <Button
        android:id="@+id/btnUninstallApp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="إلغاء تثبيت التطبيق التجريبي" />

    <Button
        android:id="@+id/btnBack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="العودة" />

</LinearLayout>
