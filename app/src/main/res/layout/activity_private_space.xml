<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#0F172A">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="المساحة الخاصة"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingBottom="8dp" />

    <TextView
        android:id="@+id/tvPrivateStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="الحالة: جاري التحقق..."
        android:textColor="#CBD5E1"
        android:textSize="14sp"
        android:padding="12dp" />

    <Button
        android:id="@+id/btnPickApk"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="إضافة تطبيق من ملف APK" />

    <Button
        android:id="@+id/btnRefreshApps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="تحديث التطبيقات" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:paddingTop="10dp">

        <LinearLayout
            android:id="@+id/appsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <Button
        android:id="@+id/btnBack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="العودة" />
</LinearLayout>
