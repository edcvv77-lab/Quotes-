<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_private_root">

    <ImageView
        android:id="@+id/hadeelButterfly"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_gravity="start|top"
        android:layout_marginStart="10dp"
        android:layout_marginTop="58dp"
        android:alpha="0.88"
        android:contentDescription="فراشة"
        android:src="@drawable/ic_hadeel_butterfly" />

    <ImageView
        android:id="@+id/hadeelSparkles"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="end|top"
        android:layout_marginTop="26dp"
        android:layout_marginEnd="18dp"
        android:alpha="0.76"
        android:contentDescription="لمعات"
        android:src="@drawable/ic_hadeel_sparkles" />

    <ImageView
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="88dp"
        android:alpha="0.34"
        android:contentDescription="زهرة"
        android:src="@drawable/ic_hadeel_flower" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:id="@+id/privateHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="6dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="30dp"
                android:contentDescription="تاج"
                android:src="@drawable/ic_hadeel_crown" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="مساحة هديل الخاصة"
                android:textColor="@color/private_text"
                android:textSize="29sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/privateNameSticker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_hadeel_name_sticker"
                android:text="✨ هديل ✨"
                android:textColor="@color/private_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="تطبيقات منفصلة داخل اقتباسات"
                android:textColor="@color/private_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/privateStatusCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_private_status"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="11dp"
            android:paddingEnd="14dp"
            android:paddingBottom="11dp">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:contentDescription="حالة المساحة"
                android:src="@drawable/ic_hadeel_shield" />

            <TextView
                android:id="@+id/tvPrivateStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="11dp"
                android:layout_weight="1"
                android:lineSpacingExtra="2dp"
                android:text="جاري التحقق..."
                android:textColor="@color/private_text"
                android:textSize="12.5sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/privateActionRow"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCloneInstalledApp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_hadeel_clone_button"
                android:backgroundTint="@null"
                android:drawableStart="@drawable/ic_hadeel_clone"
                android:drawablePadding="7dp"
                android:gravity="center"
                android:minHeight="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:stateListAnimator="@null"
                android:text="نسخ تطبيق"
                android:textAllCaps="false"
                android:textColor="@color/private_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnPickApk"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_hadeel_apk_button"
                android:backgroundTint="@null"
                android:drawableStart="@drawable/ic_hadeel_apk"
                android:drawablePadding="7dp"
                android:gravity="center"
                android:minHeight="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:stateListAnimator="@null"
                android:text="إضافة APK"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/btnRefreshApps"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_hadeel_refresh_button"
            android:backgroundTint="@null"
            android:drawableStart="@drawable/ic_hadeel_refresh"
            android:drawablePadding="9dp"
            android:gravity="center"
            android:minHeight="0dp"
            android:stateListAnimator="@null"
            android:text="تحديث التطبيقات"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="18dp"
                android:contentDescription="قلب"
                android:src="@drawable/ic_hadeel_heart" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:text="تطبيقات هديل"
                android:textColor="@color/private_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="اضغط للتشغيل • مطولًا للإدارة"
                android:textColor="@color/private_muted"
                android:textSize="10sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/privateAppsPanel"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="7dp"
            android:layout_weight="1"
            android:background="@drawable/bg_private_panel"
            android:padding="6dp">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:overScrollMode="never">

                <GridLayout
                    android:id="@+id/appsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alignmentMode="alignMargins"
                    android:columnCount="3"
                    android:useDefaultMargins="false" />
            </ScrollView>
        </FrameLayout>

        <Button
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="9dp"
            android:background="@drawable/bg_private_lock"
            android:backgroundTint="@null"
            android:drawableStart="@drawable/ic_hadeel_lock"
            android:drawablePadding="9dp"
            android:gravity="center"
            android:minHeight="0dp"
            android:stateListAnimator="@null"
            android:text="قفل والعودة للاقتباسات"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>